{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 109, "custom_header": "DiAnEx", "event_id": 317, "event_name": "SCN - Henry Diana Fight", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:2ba3dd2c2669c98d373f", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 109, "event_id": 317, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "A new leader is taking over. And he’s not going to meet the same fate as those you’re arresting.", "structure": {"command_code": 355, "header": "DiAnEx", "raw_value": "DiAnEx.A new leader is taking over. And he’s not going to meet the same fate as those you’re arresting.", "routed_common_event_id": 60, "script_literal": "\"DiAnEx.A new leader is taking over. And he’s not going to meet the same fate as those you’re arresting.\"", "separator": ".", "variable_id": 21}, "translation": "Władzę przejmuje nowy przywódca. Nie skończy jak ci, których aresztujecie."}
