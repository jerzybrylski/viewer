{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 49, "custom_header": "DuAnOp", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:3f3a0b25a24cb4021ddb", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 49, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "This was going to be my city. And now you’ve muddied it all up.", "structure": {"command_code": 355, "header": "DuAnOp", "raw_value": "DuAnOp.This was going to be my city. And now you’ve muddied it all up.", "routed_common_event_id": 60, "script_literal": "\"DuAnOp.This was going to be my city. And now you’ve muddied it all up.\"", "separator": ".", "variable_id": 21}, "translation": "To miało być moje miasto. A ty wszystko popsułeś."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 51, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:bd486c14563457450642", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 51, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "I don’t know what the hell you’re talking about.", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.I don’t know what the hell you’re talking about.", "routed_common_event_id": 60, "script_literal": "\"McAnDe.I don’t know what the hell you’re talking about.\"", "separator": ".", "variable_id": 21}, "translation": "Nie wiem, o czym ty, do cholery, mówisz."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 53, "custom_header": "DuAnEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:57c3b47203631a8a6274", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 53, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "I’m going to ask you some questions and you’re going to answer them.", "structure": {"command_code": 355, "header": "DuAnEx", "raw_value": "DuAnEx.I’m going to ask you some questions and you’re going to answer them.", "routed_common_event_id": 60, "script_literal": "\"DuAnEx.I’m going to ask you some questions and you’re going to answer them.\"", "separator": ".", "variable_id": 21}, "translation": "Zadam ci kilka pytań, a ty na nie odpowiesz."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 55, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:f7ab689ad4731834e09b", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 55, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "What the hell do you want with me?", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.What the hell do you want with me?", "routed_common_event_id": 60, "script_literal": "\"McAnDe.What the hell do you want with me?\"", "separator": ".", "variable_id": 21}, "translation": "Czego ty, do cholery, ode mnie chcesz?"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 57, "custom_header": "DuAnEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:5b22ecd8abdfd3daf7ea", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 57, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "You’re going to tell me everything you know about Madalyn Rose.", "structure": {"command_code": 355, "header": "DuAnEx", "raw_value": "DuAnEx.You’re going to tell me everything you know about Madalyn Rose.", "routed_common_event_id": 60, "script_literal": "\"DuAnEx.You’re going to tell me everything you know about Madalyn Rose.\"", "separator": ".", "variable_id": 21}, "translation": "Powiesz mi wszystko, co wiesz o Madalyn Rose."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 59, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:151d82c8de5c24af6925", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 59, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "I don’t know her. I have nothing for you.", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.I don’t know her. I have nothing for you.", "routed_common_event_id": 60, "script_literal": "\"McAnDe.I don’t know her. I have nothing for you.\"", "separator": ".", "variable_id": 21}, "translation": "Nie znam jej. Niczego ode mnie nie dostaniesz."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 61, "custom_header": "DuAnEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:488d89895155d95e7a20", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 61, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "On the contrary, detective. You have one of the amulets I was looking for.", "structure": {"command_code": 355, "header": "DuAnEx", "raw_value": "DuAnEx.On the contrary, detective. You have one of the amulets I was looking for.", "routed_common_event_id": 60, "script_literal": "\"DuAnEx.On the contrary, detective. You have one of the amulets I was looking for.\"", "separator": ".", "variable_id": 21}, "translation": "Wręcz przeciwnie, detektywie. Masz jeden z amuletów, których szukałem."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 65, "custom_header": "NeAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:e26af1049d0c0c39708a", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 65, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "He knows a lot more than he’s letting on. We need to know everything he knows.", "structure": {"command_code": 355, "header": "NeAnDe", "raw_value": "NeAnDe.He knows a lot more than he’s letting on. We need to know everything he knows.", "routed_common_event_id": 60, "script_literal": "\"NeAnDe.He knows a lot more than he’s letting on. We need to know everything he knows.\"", "separator": ".", "variable_id": 21}, "translation": "Wie znacznie więcej, niż mówi. Musimy dowiedzieć się wszystkiego, co wie."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 67, "custom_header": "DuBaEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:dec3cafd2206d68276a9", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 67, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "The lady here got into a lot of trouble with old Madalyn.", "structure": {"command_code": 355, "header": "DuBaEx", "raw_value": "DuBaEx.The lady here got into a lot of trouble with old Madalyn.", "routed_common_event_id": 60, "script_literal": "\"DuBaEx.The lady here got into a lot of trouble with old Madalyn.\"", "separator": ".", "variable_id": 21}, "translation": "Ta pani nieźle podpadła starej Madalyn."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 69, "custom_header": "McAnEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:ab788ecf6196330af5af", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 69, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "She’s a witch… That’s my guess.", "structure": {"command_code": 355, "header": "McAnEx", "raw_value": "McAnEx.She’s a witch… That’s my guess.", "routed_common_event_id": 60, "script_literal": "\"McAnEx.She’s a witch… That’s my guess.\"", "separator": ".", "variable_id": 21}, "translation": "To czarownica… Tak mi się wydaje."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 71, "custom_header": "DuFlEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:13f66d875d261c4d4877", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 71, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Give me a name, 1Hero. Maybe you’re not our guy.", "structure": {"command_code": 355, "header": "DuFlEx", "raw_value": "DuFlEx.Give me a name, 1Hero. Maybe you’re not our guy.", "routed_common_event_id": 60, "script_literal": "\"DuFlEx.Give me a name, 1Hero. Maybe you’re not our guy.\"", "separator": ".", "variable_id": 21}, "translation": "Podaj nazwisko, 1Hero. Może to nie ciebie szukamy."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 75, "custom_header": "DuAnOp", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:ededd1bebd18fe08d005", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 75, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Who knows about Madalyn?", "structure": {"command_code": 355, "header": "DuAnOp", "raw_value": "DuAnOp.Who knows about Madalyn?", "routed_common_event_id": 60, "script_literal": "\"DuAnOp.Who knows about Madalyn?\"", "separator": ".", "variable_id": 21}, "translation": "Kto wie o Madalyn?"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 77, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:f9004ee531a5564ae392", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 77, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "I saw her messing with the red-head. That’s all the info I got.", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.I saw her messing with the red-head. That’s all the info I got.", "routed_common_event_id": 60, "script_literal": "\"McAnDe.I saw her messing with the red-head. That’s all the info I got.\"", "separator": ".", "variable_id": 21}, "translation": "Widziałem, jak majstrowała przy rudowłosej. Tyle wiem."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 79, "custom_header": "DuMaAg", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:1d58fc4fe8b1f0fb8c1b", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 79, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Where did you get that amulet? Give me a name, or you’re going to die.", "structure": {"command_code": 355, "header": "DuMaAg", "raw_value": "DuMaAg.Where did you get that amulet? Give me a name, or you’re going to die.", "routed_common_event_id": 60, "script_literal": "\"DuMaAg.Where did you get that amulet? Give me a name, or you’re going to die.\"", "separator": ".", "variable_id": 21}, "translation": "Skąd masz ten amulet? Podaj nazwisko albo zginiesz."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 81, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:e962d7949c20f7190f04", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 81, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Something tells me I’m going to die anyways.", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.Something tells me I’m going to die anyways.", "routed_common_event_id": 60, "script_literal": "\"McAnDe.Something tells me I’m going to die anyways.\"", "separator": ".", "variable_id": 21}, "translation": "Coś mi mówi, że i tak zginę."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 83, "custom_header": "DuBaOp", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:a542c0d50f26cfb75262", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 83, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "You searching for them? Was it in the church? Why did you keep it?", "structure": {"command_code": 355, "header": "DuBaOp", "raw_value": "DuBaOp.You searching for them? Was it in the church? Why did you keep it?", "routed_common_event_id": 60, "script_literal": "\"DuBaOp.You searching for them? Was it in the church? Why did you keep it?\"", "separator": ".", "variable_id": 21}, "translation": "Szukasz ich? Znalazłeś go w kościele? Czemu go zatrzymałeś?"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 85, "custom_header": "McAnDe", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:04d5c6336be82f78b52e", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 85, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "It was shiny. Detective work doesn't pay well.", "structure": {"command_code": 355, "header": "McAnDe", "raw_value": "McAnDe.It was shiny. Detective work doesn't pay well.", "routed_common_event_id": 60, "script_literal": "\"McAnDe.It was shiny. Detective work doesn't pay well.\"", "separator": ".", "variable_id": 21}, "translation": "Błyszczał. Praca detektywa nie jest dobrze płatna."}
