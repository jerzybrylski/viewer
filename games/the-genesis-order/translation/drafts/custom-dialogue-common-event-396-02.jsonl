{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 91, "custom_header": "NeAnEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:b309e39e90c2d3460458", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 91, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "He’s got info! We need to get it from him.", "structure": {"command_code": 355, "header": "NeAnEx", "raw_value": "NeAnEx.He’s got info! We need to get it from him.", "routed_common_event_id": 60, "script_literal": "\"NeAnEx.He’s got info! We need to get it from him.\"", "separator": ".", "variable_id": 21}, "translation": "Ma informacje! Musimy je z niego wyciągnąć."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 93, "custom_header": "DuFlEx", "event_id": 396, "event_name": "SCN - Duncan Interview", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:0632e33033f425d4fc1b", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 93, "event_id": 396, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Don’t worry, Nellie. We’re halfway there. We’ll find the last amulet.", "structure": {"command_code": 355, "header": "DuFlEx", "raw_value": "DuFlEx.Don’t worry, Nellie. We’re halfway there. We’ll find the last amulet.", "routed_common_event_id": 60, "script_literal": "\"DuFlEx.Don’t worry, Nellie. We’re halfway there. We’ll find the last amulet.\"", "separator": ".", "variable_id": 21}, "translation": "Nie martw się, Nellie. Jesteśmy w połowie drogi. Znajdziemy ostatni amulet."}
