{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 71, "custom_header": "MeBaOp", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:5e9587dea5b655be326c", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 71, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Somehow the Eclipse Guild avoided detection here in North Santiva. Those details are still yet to be uncovered.", "structure": {"command_code": 355, "header": "MeBaOp", "raw_value": "MeBaOp.Somehow the Eclipse Guild avoided detection here in North Santiva. Those details are still yet to be uncovered.", "routed_common_event_id": 60, "script_literal": "\"MeBaOp.Somehow the Eclipse Guild avoided detection here in North Santiva. Those details are still yet to be uncovered.\"", "separator": ".", "variable_id": 21}, "translation": "W jakiś sposób Gildia Zaćmienia uniknęła wykrycia w North Santiva. Wciąż nie wiemy, jak do tego doszło."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 73, "custom_header": "KiBaOp", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:7e24bc59b47d1db0bb34", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 73, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "You’re speaking of the Wilkes mansion?", "structure": {"command_code": 355, "header": "KiBaOp", "raw_value": "KiBaOp.You’re speaking of the Wilkes mansion?", "routed_common_event_id": 60, "script_literal": "\"KiBaOp.You’re speaking of the Wilkes mansion?\"", "separator": ".", "variable_id": 21}, "translation": "Mówi pani o rezydencji Wilkesów?"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 75, "custom_header": "MeBaEx", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:0b4aadb4e8f7c9855739", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 75, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "An operations hub, no doubt.", "structure": {"command_code": 355, "header": "MeBaEx", "raw_value": "MeBaEx.An operations hub, no doubt.", "routed_common_event_id": 60, "script_literal": "\"MeBaEx.An operations hub, no doubt.\"", "separator": ".", "variable_id": 21}, "translation": "Bez wątpienia było to centrum operacyjne."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 77, "custom_header": "McFrOp", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:07c80e98a87d29b9b8a2", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 77, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Uhh… We’re still working on discovering just how deep it went. But I wouldn’t go so far as to call North Santiva a hub.", "structure": {"command_code": 355, "header": "McFrOp", "raw_value": "McFrOp.Uhh… We’re still working on discovering just how deep it went. But I wouldn’t go so far as to call North Santiva a hub.", "routed_common_event_id": 60, "script_literal": "\"McFrOp.Uhh… We’re still working on discovering just how deep it went. But I wouldn’t go so far as to call North Santiva a hub.\"", "separator": ".", "variable_id": 21}, "translation": "Eee… Wciąż ustalamy, jak rozległa była ich działalność. Nie nazwałbym jednak North Santivy centrum operacyjnym."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 79, "custom_header": "KiFrEx", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:65a60471a535175cb7ce", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 79, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "The Eclipse Guild steals not only artwork, but rare archaeological artifacts… Could something be hidden in that mansion that would shock us?", "structure": {"command_code": 355, "header": "KiFrEx", "raw_value": "KiFrEx.The Eclipse Guild steals not only artwork, but rare archaeological artifacts… Could something be hidden in that mansion that would shock us?", "routed_common_event_id": 60, "script_literal": "\"KiFrEx.The Eclipse Guild steals not only artwork, but rare archaeological artifacts… Could something be hidden in that mansion that would shock us?\"", "separator": ".", "variable_id": 21}, "translation": "Gildia Zaćmienia kradnie nie tylko dzieła sztuki, ale też rzadkie artefakty archeologiczne… Czy w tej rezydencji może być coś, co nas zszokuje?"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 81, "custom_header": "McHaCl", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:3ac3786fd0e89eacff86", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 81, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Well… I mean… It’s possible, but…", "structure": {"command_code": 355, "header": "McHaCl", "raw_value": "McHaCl.Well… I mean… It’s possible, but…", "routed_common_event_id": 60, "script_literal": "\"McHaCl.Well… I mean… It’s possible, but…\"", "separator": ".", "variable_id": 21}, "translation": "Cóż… To znaczy… To możliwe, ale…"}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 83, "custom_header": "MeBaEx", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:828086554d1c98fa95e2", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 83, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "The mansion is being searched as we speak.", "structure": {"command_code": 355, "header": "MeBaEx", "raw_value": "MeBaEx.The mansion is being searched as we speak.", "routed_common_event_id": 60, "script_literal": "\"MeBaEx.The mansion is being searched as we speak.\"", "separator": ".", "variable_id": 21}, "translation": "Właśnie trwa przeszukanie rezydencji."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 85, "custom_header": "KiFlOp", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:af81d0e5b82c834bb79e", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 85, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "Is that so?... I look forward to reporting on what you find.", "structure": {"command_code": 355, "header": "KiFlOp", "raw_value": "KiFlOp.Is that so?... I look forward to reporting on what you find.", "routed_common_event_id": 60, "script_literal": "\"KiFlOp.Is that so?... I look forward to reporting on what you find.\"", "separator": ".", "variable_id": 21}, "translation": "Doprawdy?... Z niecierpliwością czekam na wyniki waszego śledztwa."}
{"category": "custom_dialogue", "classification": "confirmed_dialogue", "context": {"branch_path": [], "command_index": 87, "custom_header": "McBaEx", "event_id": 419, "event_name": "SCN - Interview Melissa", "map_id": null, "map_name": "", "page_conditions": null, "page_number": null, "source_kind": "common_event", "speaker": null, "speaker_status": "header_requires_mapping"}, "id": "tgo:custom_dialogue:459121f74c5df6630a99", "markup_tokens": [], "schema": "tgo-translation-record-v1", "source": {"file": "data/CommonEvents.json", "locator": {"assignment_index": 0, "command_code": 355, "command_index": 87, "event_id": 419, "file": "data/CommonEvents.json", "page_number": null, "parameter_index": 0, "routed_common_event_id": 60, "script_literal_offset": 28, "variable_id": 21}, "sha256": "37321ff8693412e5e4488eb736a63b43fcbd142410008b73f5bcb317c27e3ca9", "writeback": "script_string_literal"}, "source_text": "The estate is in the city's hands now. Charles Wilkes and his beneficiaries are all under criminal investigation.", "structure": {"command_code": 355, "header": "McBaEx", "raw_value": "McBaEx.The estate is in the city's hands now. Charles Wilkes and his beneficiaries are all under criminal investigation.", "routed_common_event_id": 60, "script_literal": "\"McBaEx.The estate is in the city's hands now. Charles Wilkes and his beneficiaries are all under criminal investigation.\"", "separator": ".", "variable_id": 21}, "translation": "Posiadłość jest teraz w rękach miasta. Charles Wilkes i jego spadkobiercy są objęci śledztwem kryminalnym."}
