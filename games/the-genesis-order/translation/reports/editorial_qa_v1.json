      "samples": [
        {
          "id": "tgo:arianna_hint:30fdfd7bf5de71913ad1",
          "text": "Znajdź klucz do szafki na ściance wspinaczkowej na siłowni, a potem otwórz szafkę — jest w niej coś, czego potrzebujesz."
        },
        {
          "id": "tgo:arianna_hint:4973527531e983daff39",
          "text": "Ukończyłeś ten rozdział! Ale bez obaw — nowe treści pojawią się już za kilka tygodni."
        },
        {
          "id": "tgo:custom_dialogue:5e08b3ff2f3d2dd166f7",
          "text": "Ukończyłeś ten rozdział! Ale bez obaw — nowe treści pojawią się już za kilka tygodni."
        },
        {
          "id": "tgo:custom_dialogue:7f9d4f4baa4d31a7f6b4",
          "text": "Nie tylko mordowała — porywała ludzi."
        },
        {
          "id": "tgo:custom_dialogue:dfa271d9d2041452ac10",
          "text": "Mężczyzna twoich lubieżnych pragnień jest gotów — z pulsującym kutasem i nieposkromioną żądzą, by zasiać w tobie swoje nasienie."
        },
        {
          "id": "tgo:custom_dialogue:c7fb4ef9d7c67ce7c641",
          "text": "Jeśli dobrze pójdzie, kto wie — może wyniknie z tego coś więcej."
        },
        {
          "id": "tgo:custom_dialogue:d465bdd23fc80bb68609",
          "text": "A dlaczego Madalyn? Pomijając, że jest tylko jedną zakonnicą — po co miałaby to robić? Jaki miałaby motyw?"
        },
        {
          "id": "tgo:custom_dialogue:4106ab6c081a4492c7b0",
          "text": "Jak sama powiedziała — teraz nasza kolej."
        }
      ]
    },
